# ── Nile ERP backend configuration ──
# Copy this file to ".env" and fill in the values.

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/nile?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Port the API listens on.
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# Use * during local development, lock it down in production.
CORS_ORIGIN=*

# Optional: email of the first super-admin account (gets isSuperAdmin on register).
SUPER_ADMIN_EMAIL=

# ── Billing / payments ──
# Your Vodafone Cash wallet number and InstaPay handle. Shown to customers on
# the checkout screen; they transfer manually and submit the reference, which
# the super admin verifies to activate the plan.
VODAFONE_CASH_NUMBER=
INSTAPAY_HANDLE=

# Optional: plug in a real gateway (Paymob / Kashier) that exposes Vodafone Cash
# & InstaPay via API. When set, the app can offer automated card/wallet checkout.
PAYMOB_API_KEY=
KASHIER_API_KEY=
