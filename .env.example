# ── Firebase connection ──
# Copy this file to ".env" and fill values from your Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration (Config)
# Then restart the dev server. The app auto-switches from local to cloud mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Optional: real AI Copilot via Claude API (otherwise it runs offline) ──
# VITE_ANTHROPIC_API_KEY=

# ── MongoDB backend ──
# Point this at your running API server (see /server). When set, the app uses
# MongoDB for auth + data sync instead of Firebase. Include the /api suffix.
# Example: http://localhost:4000/api
VITE_API_URL=
